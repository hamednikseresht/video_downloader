# Copy to .env (gitignored). Real environment variables take precedence.
# Values here override settings.json and are never written back to it.

# Folder for finished downloads (default: ./downloads)
# YTDL_DOWNLOAD_DIR=

# Path to ffmpeg binary or its folder (default: auto-detect)
# YTDL_FFMPEG_PATH=

# Netscape cookies.txt for YouTube/Instagram auth (default: ./cookies.txt)
# YTDL_COOKIES_PATH=

# Read cookies from a logged-in browser: firefox | edge | chrome | brave
# YTDL_COOKIES_BROWSER=firefox

# Seconds between batch items (0-120)
# YTDL_BATCH_PAUSE_SEC=2
